---
import Layout from '../layouts/Layout.astro';
import carbonIcon from '../assets/carbon-icon-2.png';
import {
  Download01Icon,
  GithubIcon,
  LockIcon,
  InformationCircleIcon,
  ClipboardIcon,
  KeyboardIcon,
  BrowserIcon,
  BellIcon,
  ImageIcon,
  Search01Icon,
  MoveIcon,
  FolderIcon,
  Delete01Icon,
  MouseLeftClick01Icon,
  Layout01Icon,
  PinIcon,
  HeartIcon,
  SparklesIcon
} from '@hugeicons/core-free-icons';
---

<Layout title="Carbon — A quiet place for useful things" description="Capture an answer, a link, or a half-formed thought. Carbon keeps it close without getting in your way. Reimagined for Windows.">
	
	<!-- Background Gradients & Glows -->
	<div class="relative w-full overflow-hidden">
		<!-- Large Top Radial Glow -->
		<div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[650px] bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-zinc-800/25 via-transparent to-transparent pointer-events-none -z-10"></div>
		
		<!-- Custom grid background -->
		<div class="absolute inset-0 bg-[linear-gradient(to_right,#1f1f23_1px,transparent_1px),linear-gradient(to_bottom,#1f1f23_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-20 pointer-events-none -z-20"></div>

		<!-- Navigation Header -->
		<header class="max-w-6xl mx-auto px-6 py-6 flex items-center justify-between border-b border-zinc-900/50">
			<a href="#" class="flex items-center gap-2.5 group">
				<div class="h-8 w-8 rounded-lg overflow-hidden border border-zinc-800 flex items-center justify-center transition-all group-hover:border-zinc-700 shadow-inner">
					<img src={carbonIcon.src} alt="Carbon logo" class="h-5 w-5 object-contain" />
				</div>
				<span class="font-medium text-lg tracking-tight text-zinc-100 group-hover:text-white">Carbon</span>
			</a>
			
			<div class="flex items-center gap-4">
				<span class="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-zinc-800/80 bg-zinc-900/40 px-3 py-1 text-xs text-zinc-400 font-mono">
					<span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
					v1.0.0 for Windows
				</span>
				<a 
					href="https://github.com/Himanshu-Singh-Chauhan/Carbon-ShadCN-Copper-for-windows" 
					target="_blank" 
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 text-sm text-zinc-400 hover:text-zinc-100 transition-colors"
					id="nav-github-link"
				>
					<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none">
						{GithubIcon.map(([tag, attrs]) => {
							const Tag = tag;
							return <Tag {...attrs} />;
						})}
					</svg>
					<span class="sr-only">GitHub</span>
				</a>
			</div>
		</header>

		<!-- Hero Section -->
		<main class="max-w-6xl mx-auto px-6 pt-10 md:pt-16 pb-20">
			<div class="text-center max-w-3xl mx-auto flex flex-col items-center">
				<div class="inline-flex items-center gap-1.5 rounded-full border border-zinc-800 bg-zinc-900/60 px-3.5 py-1 text-xs text-zinc-400 font-mono mb-6 backdrop-blur-sm">
					<span>New release</span>
					<span class="text-zinc-600">•</span>
					<span class="text-zinc-200">Carbon for Windows</span>
				</div>
				
				<h1 class="text-5xl md:text-7xl font-bold tracking-tight text-transparent bg-clip-text bg-gradient-to-b from-zinc-100 to-zinc-500 select-none pb-2">
					A quiet place for useful things
				</h1>
				
				<p class="text-lg md:text-xl text-zinc-400 max-w-2xl mt-6 font-light leading-relaxed">
					Capture an answer, a link, or a half-formed thought. Carbon keeps it close without getting in your way.
				</p>
				<!-- Quick Features Popover (Above CTAs) -->
				<div class="mt-4 relative inline-block group">
					<button class="inline-flex items-center gap-2 text-sm font-medium text-zinc-100 hover:text-white transition-all border border-zinc-800 bg-zinc-900/60 hover:bg-zinc-800/70 px-5 py-2.5 rounded-full cursor-pointer select-none shadow-[0_4px_12px_rgba(0,0,0,0.3)] hover:border-zinc-700">
						<svg class="h-4 w-4 text-zinc-200" viewBox="0 0 24 24" fill="none">
							{SparklesIcon.map(([tag, attrs]) => {
								const Tag = tag;
								return <Tag {...attrs} />;
							})}
						</svg>
						Quick Features at a Glance
					</button>
					
					<!-- Hover Popover Card Wrapper (includes visual gap padding to prevent hover loss) -->
					<div class="absolute left-1/2 -translate-x-1/2 bottom-full pb-3.5 w-[310px] sm:w-[680px] md:w-[760px] opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 z-50">
						<!-- Actual visible card (No max-height, everything visible at once) -->
						<div class="bg-zinc-950/98 border border-zinc-800/90 rounded-xl p-6 shadow-[0_25px_60px_rgba(0,0,0,0.95)] backdrop-blur-xl text-left">
							<h4 class="text-xs font-mono uppercase tracking-wider text-zinc-400 border-b border-zinc-900 pb-3 mb-4 select-none">Carbon Features</h4>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3.5">
								<div class="flex items-start gap-2.5">
									<div class="h-1.5 w-1.5 rounded-full bg-zinc-600 mt-2 shrink-0"></div>
									<span class="text-[13.5px] text-zinc-200 leading-normal font-light">Always-on-top mode</span>
								</div>
								<div class="flex items-start gap-2.5">
									<div class="h-1.5 w-1.5 rounded-full bg-zinc-600 mt-2 shrink-0"></div>
									<span class="text-[13.5px] text-zinc-200 leading-normal font-light">Markdown support</span>
								</div>
								<div class="flex items-start gap-2.5">
									<div class="h-1.5 w-1.5 rounded-full bg-zinc-600 mt-2 shrink-0"></div>
									<span class="text-[13.5px] text-zinc-200 leading-normal font-light">Images and image galleries, with full-screen viewer</span>
								</div>
								<div class="flex items-start gap-2.5">
									<div class="h-1.5 w-1.5 rounded-full bg-zinc-600 mt-2 shrink-0"></div>
									<span class="text-[13.5px] text-zinc-200 leading-normal font-light">Capture from anywhere on your desktop</span>
								</div>
								<div class="flex items-start gap-2.5">
									<div class="h-1.5 w-1.5 rounded-full bg-zinc-600 mt-2 shrink-0"></div>
									<span class="text-[13.5px] text-zinc-200 leading-normal font-light">Drag and drop support</span>
								</div>
								<div class="flex items-start gap-2.5">
									<div class="h-1.5 w-1.5 rounded-full bg-zinc-600 mt-2 shrink-0"></div>
									<span class="text-[13.5px] text-zinc-200 leading-normal font-light">Global capture shortcuts (fully customizable): Shift+Shift, Ctrl+Ctrl, Alt+Alt, or your own</span>
								</div>
								<div class="flex items-start gap-2.5">
									<div class="h-1.5 w-1.5 rounded-full bg-zinc-600 mt-2 shrink-0"></div>
									<span class="text-[13.5px] text-zinc-200 leading-normal font-light">Global paste (Ctrl+V) — no need to focus a text box. Open Carbon and paste from anywhere.</span>
								</div>
								<div class="flex items-start gap-2.5">
									<div class="h-1.5 w-1.5 rounded-full bg-zinc-600 mt-2 shrink-0"></div>
									<span class="text-[13.5px] text-zinc-200 leading-normal font-light">Automatically remembers which app each capture came from</span>
								</div>
								<div class="flex items-start gap-2.5">
									<div class="h-1.5 w-1.5 rounded-full bg-zinc-600 mt-2 shrink-0"></div>
									<span class="text-[13.5px] text-zinc-200 leading-normal font-light">Multiple buckets to organize captures</span>
								</div>
								<div class="flex items-start gap-2.5">
									<div class="h-1.5 w-1.5 rounded-full bg-zinc-600 mt-2 shrink-0"></div>
									<span class="text-[13.5px] text-zinc-200 leading-normal font-light">Designed for temporary notes—not endless hoarding</span>
								</div>
								<div class="flex items-start gap-2.5">
									<div class="h-1.5 w-1.5 rounded-full bg-zinc-600 mt-2 shrink-0"></div>
									<span class="text-[13.5px] text-zinc-200 leading-normal font-light">FZF-style fuzzy search</span>
								</div>
								<div class="flex items-start gap-2.5">
									<div class="h-1.5 w-1.5 rounded-full bg-zinc-600 mt-2 shrink-0"></div>
									<span class="text-[13.5px] text-zinc-200 leading-normal font-light">Right-click + drag to scroll (like a touchscreen)</span>
								</div>
								<div class="flex items-start gap-2.5">
									<div class="h-1.5 w-1.5 rounded-full bg-zinc-600 mt-2 shrink-0"></div>
									<span class="text-[13.5px] text-zinc-200 leading-normal font-light">Double-click to copy or edit</span>
								</div>
								<div class="flex items-start gap-2.5">
									<div class="h-1.5 w-1.5 rounded-full bg-zinc-600 mt-2 shrink-0"></div>
									<span class="text-[13.5px] text-zinc-200 leading-normal font-light">Light & dark themes with custom background images</span>
								</div>
								<div class="flex items-start gap-2.5">
									<div class="h-1.5 w-1.5 rounded-full bg-zinc-600 mt-2 shrink-0"></div>
									<span class="text-[13.5px] text-zinc-200 leading-normal font-light">Minimize to system tray</span>
								</div>
								<div class="flex items-start gap-2.5">
									<div class="h-1.5 w-1.5 rounded-full bg-zinc-600 mt-2 shrink-0"></div>
									<span class="text-[13.5px] text-zinc-200 leading-normal font-light">Global shortcut to open Carbon</span>
								</div>
								<div class="flex items-start gap-2.5">
									<div class="h-1.5 w-1.5 rounded-full bg-zinc-600 mt-2 shrink-0"></div>
									<span class="text-[13.5px] text-zinc-200 leading-normal font-light">Capture notification with one-click bucket selection</span>
								</div>
								<div class="flex items-start gap-2.5">
									<div class="h-1.5 w-1.5 rounded-full bg-zinc-600 mt-2 shrink-0"></div>
									<span class="text-[13.5px] text-zinc-200 leading-normal font-light">Double-click the notification to open Carbon</span>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- CTAs -->
				<div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-4 w-full sm:w-auto">
					<a 
						href="https://github.com/Himanshu-Singh-Chauhan/Carbon-ShadCN-Copper-for-windows/releases/download/1.0.0/Carbon_1.0.0_x64-setup.exe"
						target="_blank"
						rel="noopener noreferrer" 
						class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 bg-zinc-100 hover:bg-zinc-200 text-zinc-950 font-medium rounded-lg transition-all shadow-[0_0_30px_rgba(255,255,255,0.08)] hover:shadow-[0_0_40px_rgba(255,255,255,0.18)]"
						id="hero-download-btn"
					>
						<svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none">
							{Download01Icon.map(([tag, attrs]) => {
								const Tag = tag;
								return <Tag {...attrs} />;
							})}
						</svg>
						Get Carbon for Windows
					</a>
					<a 
						href="https://github.com/Himanshu-Singh-Chauhan/Carbon-ShadCN-Copper-for-windows"
						target="_blank"
						rel="noopener noreferrer" 
						class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 bg-zinc-900/60 hover:bg-zinc-800/80 border border-zinc-800 hover:border-zinc-700 text-zinc-300 hover:text-white rounded-lg transition-all backdrop-blur-sm"
						id="hero-github-btn"
					>
						<svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none">
							{GithubIcon.map(([tag, attrs]) => {
								const Tag = tag;
								return <Tag {...attrs} />;
							})}
						</svg>
						Source Code
					</a>
				</div>

				<!-- Support Link -->
				<p class="text-sm text-zinc-400 mt-6 font-light flex items-center justify-center gap-2">
					<svg class="h-3.5 w-3.5 text-red-500/80 shrink-0" fill="none" viewBox="0 0 24 24">
						{HeartIcon.map(([tag, attrs]) => {
							const Tag = tag;
							return <Tag {...attrs} fill="currentColor" />;
						})}
					</svg>
					<span>If you enjoy using Carbon, you can <a href="https://checkout.dodopayments.com/buy/pdt_0NkkeL9Q4sqDs7o9DMNrc?quantity=1" target="_blank" rel="noopener noreferrer" class="text-zinc-200 hover:text-white font-medium underline underline-offset-4 decoration-zinc-700 hover:decoration-zinc-300 transition-colors" id="support-link">show your support</a>.</span>
				</p>
			</div>

			<!-- Sleek YouTube Video Mock Window -->
			<div class="max-w-4xl mx-auto mt-10 md:mt-14 relative group">
				<!-- Behind glowing aura -->
				<div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-zinc-800 to-zinc-900 opacity-20 blur-xl group-hover:opacity-30 transition-all duration-700 -z-10"></div>
				
				<!-- Mock window frame -->
				<div class="border border-zinc-800/80 bg-zinc-950/80 rounded-2xl overflow-hidden shadow-[0_25px_60px_-15px_rgba(0,0,0,0.8)] backdrop-blur-xl">
					<!-- Window title bar -->
					<div class="flex items-center justify-between px-4 py-3 border-b border-zinc-900/60 bg-zinc-900/10">
						<div class="flex items-center gap-1.5">
							<div class="h-3 w-3 rounded-full bg-zinc-800/60"></div>
							<div class="h-3 w-3 rounded-full bg-zinc-800/40"></div>
							<div class="h-3 w-3 rounded-full bg-zinc-800/30"></div>
						</div>
						<div class="text-[11px] font-mono text-zinc-500 tracking-wide font-light select-none">
							carbon-showcase.mp4
						</div>
						<div class="w-12"></div> <!-- Spacer to match dots -->
					</div>
					
					<!-- YouTube Embed Frame -->
					<div class="aspect-video w-full relative">
						<iframe 
							id="carbon-video-demo"
							class="absolute inset-0 w-full h-full border-0" 
							src="https://www.youtube.com/embed/sUCJpFl3VsU" 
							title="Carbon for Windows Demo Video" 
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
							allowfullscreen
						></iframe>
					</div>
				</div>
			</div>

			<!-- Use Case Narrative Section -->
			<section class="max-w-4xl mx-auto mt-28 border-y border-zinc-900/40 pt-16 pb-10">
				<!-- Heading spanning full width -->
				<h2 class="text-2xl md:text-3xl font-semibold text-zinc-200 tracking-tight leading-tight mb-8">
					Designed for active thinking.
				</h2>
				
				<!-- Grid for paragraphs -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start">
					<div class="space-y-6">
						<p class="text-sm md:text-base text-zinc-400 leading-relaxed font-light">
							You know how you're writing code in Cursor, compiling study notes in Chrome, or bouncing ideas off ChatGPT, and you think, <span class="text-zinc-300">"I'll need this snippet later,"</span> but you don't want to stop what you're doing?
						</p>
						<p class="text-sm md:text-base text-zinc-400 leading-relaxed font-light">
							Before long, you've got ideas scattered everywhere. A link to research, a homework answer you want to keep, or four follow-up prompts before your current generation is even finished.
						</p>
					</div>
					
					<div class="space-y-6">
						<p class="text-sm md:text-base text-zinc-300 leading-relaxed font-light">
							Carbon combines the best parts of a clipboard, a to-do list, and a scratchpad into one native utility. It fits seamlessly into modern AI workflows, study sessions, and keyboard-first development pipelines.
						</p>
						<p class="text-sm md:text-base text-zinc-400 leading-relaxed font-light">
							Whenever you find something worth keeping, double-tap <kbd class="font-mono bg-zinc-900 px-1 py-0.5 rounded text-xs border border-zinc-850">Shift</kbd> to capture it. When you're ready, copy it right back into ChatGPT, Claude, or your workspace—and check things off as you go.
						</p>
					</div>
				</div>

				<!-- Realigned metadata footer row: always aligned horizontally -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-10 border-t border-zinc-900/40 mt-10 pt-6">
					<div class="flex items-start gap-3">
						<svg class="h-4 w-4 text-zinc-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24">
							{LockIcon.map(([tag, attrs]) => {
								const Tag = tag;
								return <Tag {...attrs} />;
							})}
						</svg>
						<p class="text-xs text-zinc-500 leading-relaxed font-light">
							<strong class="text-zinc-400 font-medium">Privacy First</strong>: Carbon runs completely local. No sync, no tracking, no accounts.
						</p>
					</div>
					
					<div class="flex items-start gap-3" id="vscode-accessibility-note">
						<svg class="h-4 w-4 text-zinc-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24">
							{InformationCircleIcon.map(([tag, attrs]) => {
								const Tag = tag;
								return <Tag {...attrs} />;
							})}
						</svg>
						<p class="text-xs text-zinc-500 leading-relaxed font-light">
							<strong class="text-zinc-400 font-medium">VS Code Integration</strong>: VS Code requires Accessibility access enabled to capture active text selections.
						</p>
					</div>
				</div>
			</section>

			<!-- Core Features Grid -->
			<section class="max-w-4xl mx-auto mt-8 md:mt-10">
				<h2 class="text-2xl md:text-3xl font-semibold text-center text-zinc-200 tracking-tight mb-12">
					Engineered to be simple.
				</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					<!-- Feature 1: Zero-Focus Fast Paste -->
					<div class="p-6 rounded-xl border border-zinc-900 bg-zinc-950/20 backdrop-blur-sm flex flex-col justify-between hover:border-zinc-800 transition-colors duration-300">
						<div>
							<div class="h-10 w-10 rounded-lg bg-zinc-900 border border-zinc-800/50 flex items-center justify-center text-zinc-300 mb-4 shadow-sm">
								<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none">
									{ClipboardIcon.map(([tag, attrs]) => {
										const Tag = tag;
										return <Tag {...attrs} />;
									})}
								</svg>
							</div>
							<h3 class="text-base font-medium text-zinc-200">Zero-Focus Fast Paste</h3>
							<p class="text-sm text-zinc-400 mt-2 font-light leading-relaxed">
								Just open Carbon and hit <kbd class="font-mono bg-zinc-900 px-1 py-0.5 rounded text-xs border border-zinc-850">Ctrl+V</kbd>. Carbon captures your clipboard instantly—no text box selection or focus needed.
							</p>
						</div>
					</div>

					<!-- Feature 2: Double-Tap Summon Hotkeys -->
					<div class="p-6 rounded-xl border border-zinc-900 bg-zinc-950/20 backdrop-blur-sm flex flex-col justify-between hover:border-zinc-800 transition-colors duration-300">
						<div>
							<div class="h-10 w-10 rounded-lg bg-zinc-900 border border-zinc-800/50 flex items-center justify-center text-zinc-300 mb-4 shadow-sm">
								<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none">
									{KeyboardIcon.map(([tag, attrs]) => {
										const Tag = tag;
										return <Tag {...attrs} />;
									})}
								</svg>
							</div>
							<h3 class="text-base font-medium text-zinc-200">Double-Tap Hotkeys</h3>
							<p class="text-sm text-zinc-400 mt-2 font-light leading-relaxed">
								Summon Carbon instantly from anywhere using configurable double-taps (<kbd class="font-mono bg-zinc-900 px-1 py-0.5 rounded text-xs border border-zinc-850">Ctrl</kbd>, <kbd class="font-mono bg-zinc-900 px-1 py-0.5 rounded text-xs border border-zinc-850">Shift</kbd>, or <kbd class="font-mono bg-zinc-900 px-1 py-0.5 rounded text-xs border border-zinc-850">Alt</kbd>).
							</p>
						</div>
					</div>

					<!-- Feature 3: Capture Anywhere with App Context -->
					<div class="p-6 rounded-xl border border-zinc-900 bg-zinc-950/20 backdrop-blur-sm flex flex-col justify-between hover:border-zinc-800 transition-colors duration-300">
						<div>
							<div class="h-10 w-10 rounded-lg bg-zinc-900 border border-zinc-800/50 flex items-center justify-center text-zinc-300 mb-4 shadow-sm">
								<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none">
									{BrowserIcon.map(([tag, attrs]) => {
										const Tag = tag;
										return <Tag {...attrs} />;
									})}
								</svg>
							</div>
							<h3 class="text-base font-medium text-zinc-200">App-Context Tracking</h3>
							<p class="text-sm text-zinc-400 mt-2 font-light leading-relaxed">
								Capture thoughts from anywhere. Carbon automatically grabs and records the source application of the clipping so you always have context.
							</p>
						</div>
					</div>

					<!-- Feature 4: Actionable Capture Notifications -->
					<div class="p-6 rounded-xl border border-zinc-900 bg-zinc-950/20 backdrop-blur-sm flex flex-col justify-between hover:border-zinc-800 transition-colors duration-300">
						<div>
							<div class="h-10 w-10 rounded-lg bg-zinc-900 border border-zinc-800/50 flex items-center justify-center text-zinc-300 mb-4 shadow-sm">
								<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none">
									{BellIcon.map(([tag, attrs]) => {
										const Tag = tag;
										return <Tag {...attrs} />;
									})}
								</svg>
							</div>
							<h3 class="text-base font-medium text-zinc-200">Actionable Notifications</h3>
							<p class="text-sm text-zinc-400 mt-2 font-light leading-relaxed">
								Switch destination buckets directly from Windows capture notifications, or double-click the notification to reveal Carbon instantly.
							</p>
						</div>
					</div>

					<!-- Feature 5: Rich Image Galleries -->
					<div class="p-6 rounded-xl border border-zinc-900 bg-zinc-950/20 backdrop-blur-sm flex flex-col justify-between hover:border-zinc-800 transition-colors duration-300">
						<div>
							<div class="h-10 w-10 rounded-lg bg-zinc-900 border border-zinc-800/50 flex items-center justify-center text-zinc-300 mb-4 shadow-sm">
								<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none">
