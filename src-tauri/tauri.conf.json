{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carbon",
  "version": "1.0.0",
  "identifier": "com.himanshu.carbon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "create": false,
        "visible": false,
        "title": "Carbon",
        "width": 390,
        "height": 720,
        "minWidth": 320,
        "minHeight": 500,
        "maxWidth": 540,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": true,
        "dragDropEnabled": false
      },
      {
        "label": "capture-toast",
        "url": "capture-toast.html",
        "create": false,
        "title": "Carbon notification",
        "width": 360,
        "height": 520,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "image-viewer",
        "url": "image-viewer.html",
        "create": false,
        "title": "Carbon image",
        "width": 1000,
        "height": 700,
        "minWidth": 520,
        "minHeight": 360,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
